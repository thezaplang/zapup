import "release_metadata";
import "std/fs";
import "std/http";
import "std/json";
import "std/process";
import "shell";

fun latestRelease() json.Object {
    var empty = new json.Object();
    var response = http.get("https://api.github.com/repos/thezaplang/thor/releases/latest");
    if !http.isSuccess(response) {
        return empty;
    }
    return release_metadata.parseObject(response.body);
}

fun binaryUrl(release: json.Object) String {
    return release_metadata.assetUrl(release, "thor");
}

pub fun install(binDir: String) Int {
    println("downloading the latest Thor release...");
    var url = binaryUrl(latestRelease());
    if url == "" {
        println("could not find the thor binary in the latest Thor release");
        return 1;
    }

    var response = http.getFollowRedirects(url, 5);
    if !http.isSuccess(response) {
        println("could not download the Thor binary");
        return 1;
    }

    var binaryPath = binDir + "/thor";
    fs.writeFile(binaryPath, response.body) or err {
        printfln("could not write the Thor binary: %d", err as Int);
        return 1;
    };

    if process.exec("chmod +x " + shell.quote(binaryPath)) != 0 {
        println("could not mark the Thor binary as executable");
        return 1;
    }

    println("Thor installed successfully");
    return 0;
}
