import "std/fs";
import "std/http";
import "std/json";
import "std/process";
import "shell";

fun latestRelease() json.JsonObject {
    var empty = new json.JsonObject();
    empty.valid = false;

    var response = http.get("https://api.github.com/repos/thezaplang/thor/releases/latest");
    if !http.isSuccess(response) {
        return empty;
    }

    var parser = new json.JsonParser(response.body);
    return parser.parseObjectFields();
}

fun binaryUrl(release: json.JsonObject) String {
    var assets = release.get("assets");
    if !assets.valid || assets.type != json.JsonType.ARRAY {
        return "";
    }

    var i = 0;
    while i < assets.arrayVal.len() {
        var asset = assets.arrayVal.at(i);
        if asset.type == json.JsonType.OBJECT {
            var parser = new json.JsonParser(asset.objectSource);
            var fields = parser.parseObjectFields();
            var name = fields.get("name");
            var url = fields.get("browser_download_url");
            if name.valid && name.type == json.JsonType.STRING && name.stringVal == "thor" &&
               url.valid && url.type == json.JsonType.STRING {
                return url.stringVal;
            }
        }
        i++;
    }
    return "";
}

pub fun install(binDir: String) Int {
    println("downloading the latest Thor release...");
    var url = binaryUrl(latestRelease());
    if url == "" {
        println("could not find the thor binary in the latest Thor release");
        return 1;
    }

    var response = http.getFollowRedirects(url, 5);
    if !http.isSuccess(response) {
        println("could not download the Thor binary");
        return 1;
    }

    var binaryPath = binDir + "/thor";
    fs.writeFile(binaryPath, response.body) or err {
        printfln("could not write the Thor binary: %d", err as Int);
        return 1;
    };

    if process.exec("chmod +x " + shell.quote(binaryPath)) != 0 {
        println("could not mark the Thor binary as executable");
        return 1;
    }

    println("Thor installed successfully");
    return 0;
}
